{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApplicationToolRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "user_id", "call_id", "tool", "arguments", "state_version"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "call_id": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "enum": ["search_catalog", "save_draft"]},
    "arguments": {"type": "object"},
    "state_version": {"type": "integer", "minimum": 0},
    "idempotency_key": {"type": "string", "minLength": 1},
    "approval_id": {"type": "string", "minLength": 1}
  },
  "allOf": [{"if": {"properties": {"tool": {"const": "save_draft"}}}, "then": {"required": ["idempotency_key", "approval_id"]}}]
}
