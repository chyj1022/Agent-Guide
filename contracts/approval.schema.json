{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApplicationApprovalRecord",
  "type": "object", "additionalProperties": false,
  "required": ["approval_id", "run_id", "user_id", "tool", "arguments_sha256", "state_version", "expires_at_epoch", "decision"],
  "properties": {
    "approval_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "arguments_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "state_version": {"type": "integer", "minimum": 0},
    "expires_at_epoch": {"type": "integer", "minimum": 0},
    "decision": {"enum": ["approved", "denied"]}
  }
}
